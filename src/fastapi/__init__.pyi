from typing import Any, Callable

class FastAPI:
    def __init__(self, *args: Any, **kwargs: Any) -> None: ...
    def get(self, path: str, *args: Any, **kwargs: Any) -> Callable[[ Any], Any]: ...
    def post(self, path: str, *args: Any, **kwargs: Any) -> Callable[[Any], Any]: ...

def Query(default: Any = ..., *args: Any, **kwargs: Any) -> Any: ...
def __getattr__(name: str) -> Any: ...
