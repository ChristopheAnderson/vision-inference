from typing import Any

class HTMLResponse:
    def __init__(self, content: Any = ..., status_code: int = 200, *args: Any, **kwargs: Any) -> None: ...

class FileResponse:
    def __init__(self, path: Any, *args: Any, **kwargs: Any) -> None: ...

class JSONResponse:
    def __init__(self, content: Any = ..., status_code: int = 200, *args: Any, **kwargs: Any) -> None: ...

def __getattr__(name: str) -> Any: ...
